# Copy to apps/server/.env and set OPENROUTER_API_KEY before running the server.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ollive
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://localhost:6379

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

BETTER_AUTH_SECRET=change-me-to-a-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

PII_REDACTION=on
LOG_PREVIEW_CHARS=200
NODE_ENV=development

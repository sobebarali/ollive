# Copy to apps/server/.env and set OPENROUTER_API_KEY before running the server.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ollive
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://localhost:6379

# Shared OpenRouter key used for the free tier. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Encrypts users' own OpenRouter keys at rest (AES-256-GCM). 32+ chars; hex or base64.
BYOK_ENCRYPTION_KEY=change-me-to-a-32-byte-key-hex-or-base64
# Lifetime spend cap per user on the shared key, in USD. Past this they must add their own key.
SHARED_KEY_LIMIT_USD=1

BETTER_AUTH_SECRET=change-me-to-a-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

PII_REDACTION=on
LOG_PREVIEW_CHARS=200

# Ingestion worker: max events per ClickHouse insert and the blocking flush window.
INGESTION_BATCH_SIZE=500
INGESTION_FLUSH_MS=5000

NODE_ENV=development
